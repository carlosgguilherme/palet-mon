<Project>
  <!-- Shared by the core, desktop and Android projects. Releases override Version with the tag. -->
  <PropertyGroup>
    <Version>2.3.1</Version>
    <Product>Palet Mon</Product>
    <Company>Palet Mon</Company>
    <Copyright>Projeto de fã, sem ligação com Nintendo, The Pokémon Company ou Cobblemon.</Copyright>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
