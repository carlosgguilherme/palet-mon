<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PaletMon</AssemblyName>
    <RootNamespace>PaletMon</RootNamespace>
    <ApplicationIcon>Assets\PaletMon.ico</ApplicationIcon>
    <Product>Palet Mon</Product>
    <AssemblyTitle>Palet Mon</AssemblyTitle>
    <Description>Estrategista de time para Cobbleverse</Description>
    <Company>Palet Mon</Company>
    <Copyright>Projeto de fã, sem ligação com Nintendo, The Pokémon Company ou Cobblemon.</Copyright>
    <Version>2.1.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\dex.json" LogicalName="dex.json" />
    <EmbeddedResource Include="Assets\PaletMon.ico" LogicalName="PaletMon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
