<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop app: window, installer and Velopack updates. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PaletMon</AssemblyName>
    <RootNamespace>PaletMon</RootNamespace>
    <ApplicationIcon>Assets\PaletMon.ico</ApplicationIcon>
    <AssemblyTitle>Palet Mon</AssemblyTitle>
    <Description>Estrategista de time para Cobbleverse</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaletMon.Core\PaletMon.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
