<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the real app window in Avalonia's headless platform and saves PNGs, to check layouts without touching the desktop. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaletMon.Core\PaletMon.Core.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

</Project>
